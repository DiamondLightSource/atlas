ui-base:
  name: {{ lowerCase name }}
  host: {{ lowerCase name }}.diamond.ac.uk

  image:
    repository: ghcr.io/diamondlightsource/atlas/{{ lowerCase name }}
    tag: # Updated by CI job with latest release version

  upstreams:
    - id: blueapi
      path: /api/blueapi/
      rewriteTarget: /
      target:
        external:
          uri: {{ lowerCase blueapiUrl }}

    - id: tiled
      path: /api/data/
      rewriteTarget: /api/v1/
      target:
        external:
          uri: https://tiled.diamond.ac.uk

    - id: supergraph
      path: /api/supergraph
      rewriteTarget: /graphql
      passHostHeader: false
      target:
        external:
          uri: https://graph.diamond.ac.uk
